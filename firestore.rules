rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read/write their own data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Beta codes — any authenticated user can read, only server can write
    match /betaCodes/{code} {
      allow read: if request.auth != null;
    }
    // Push subscriptions — user can only manage their own
    match /pushSubscriptions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Session tracking — user can only manage their own
    match /userSessions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
