{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "functions",
      "server.js",
      "node_modules",
      ".git"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {"rules": "firestore.rules"}
}
